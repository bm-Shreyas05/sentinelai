# Copy to .env and edit. Every setting has a safe default for local development.
SENTINEL_DB_PATH=var/sentinel.db
SENTINEL_MODEL_DIR=var/models
SENTINEL_POLICY_DIR=policies
# Comma-separated. CHANGE THIS before exposing the API anywhere.
SENTINEL_API_KEYS=dev-key-change-me
SENTINEL_RATE_LIMIT_PER_MIN=600
# Payments below this amount are never hard-blocked (downgraded to REVIEW)
SENTINEL_MIN_BLOCK_AMOUNT=500

# Optional alert channels
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=

# Optional: LLM-written case narratives (decisions never depend on it)
ANTHROPIC_API_KEY=
SENTINEL_LLM_MODEL=claude-opus-5-5
